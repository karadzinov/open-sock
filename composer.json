{
    "name": "laravel/lumen",
    "description": "The Laravel Lumen Framework.",
    "keywords": ["framework", "laravel", "lumen"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": ">=7.1.3",
        "appzcoder/lumen-routes-list": "^1.0",
        "codenexus/lumen-geoip": "^2.0",
        "darkaonline/swagger-lume": "5.5.*",
        "doctrine/dbal": "^2.9",
        "dusterio/lumen-passport": "^0.2.9",
        "guzzlehttp/guzzle": "^6.3",
        "illuminate/mail": "^5.7",
        "illuminate/redis": "^5.7",
        "illuminate/support": "5.*",
        "ixudra/curl": "^6.16",
        "kylekatarnls/laravel-carbon-2": "^1.0.0",
        "laravel/lumen-framework": "5.7.*",
        "league/flysystem": " ~1.0",
        "linfo/laravel": "^2.0",
        "nesbot/carbon": "2.16.0 as 1.34.0",
        "nexmo/laravel": "^1.1",
        "niellles/lumen-commands": "dev-master",
        "predis/predis": "^1.1",
        "propaganistas/laravel-phone": "^4.2",
        "pusher/pusher-php-server": "^3.3",
        "react/event-loop": "^1.0",
        "react/http": "^0.8.3",
        "vlucas/phpdotenv": "~2.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.2",
        "fzaninotto/faker": "~1.4",
        "mockery/mockery": "~1.0",
        "phpunit/phpunit": "~7.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
